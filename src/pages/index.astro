---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import StatsSection from '../components/StatsSection.astro';
import SectionBlock from '../components/SectionBlock.astro';
import { sections } from '../data/songs';
---

<Layout title="Off The Map — Repertório">
  <Nav />
  <Hero />
  <StatsSection />

  {sections.map((section, i) => (
    <SectionBlock section={section} dark={i % 2 === 1} />
  ))}

  <footer class="footer">
    <div class="wrap footer-inner">
      <p>Off The Map — mais entusiasmo do que talento, mas a gente se diverte.</p>
      <p class="muted">Feito pela própria banda. Hospedado de graça no GitHub Pages.</p>
    </div>
  </footer>
</Layout>

<style>
  .footer {
    background: var(--paper);
    color: var(--ink);
    padding: 2.5rem 0 3rem;
    border-top: var(--border-w) solid var(--ink);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
  }

  .muted {
    opacity: 0.6;
  }
</style>
