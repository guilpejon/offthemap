---
import Layout from '../../layouts/Layout.astro';
import { uniqueSongs, songSlug, keyName } from '../../data/songs';
import { lyrics } from '../../data/lyrics';

export function getStaticPaths() {
  return uniqueSongs()
    .filter((song) => lyrics[songSlug(song)])
    .map((song) => ({
      params: { slug: songSlug(song) },
      props: { song },
    }));
}

const { song } = Astro.props;
const text = lyrics[songSlug(song)];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Chord token, e.g. E, Am, G/B, Bb7, Csus4, D#m7, A2, E5, D7M, D7(9) — used to detect chord/annotation lines.
const CHORD_RE =
  /^[A-G](#|b)?(maj7|maj9|maj|m7b5|m9|m7|m6|madd9|mMaj7|min7|min|dim7|dim|aug|sus4|sus2|sus|add9|add11|m|M|6\/9|6|7sus4|7|9|11|13|2|4|5)*(\(\d+\))?(\/[A-G](#|b)?)?$/;

// Section/part labels — kept short so a stray lyric line can't false-match.
const SECTION_RE =
  /^(Intro|Verse|Chorus|Pre-?Chorus|Bridge|Outro|Riff(\s*\d+)?|Lick(\s*\d+)?|Interlude|Solo|Refr[aã]o|Ponte|Estrofe)\b.*$/i;

// Try the raw token first (handles chords with internal parens, e.g. D7(9)) before
// stripping outer wrapping parens (handles group notation, e.g. "(E" / "A)" from "(E G D A)").
function isChordToken(tok: string) {
  if (CHORD_RE.test(tok)) return true;
  const clean = tok.replace(/^\(+/, '').replace(/[),.;]+$/, '');
  return clean.length > 0 && CHORD_RE.test(clean);
}

function isAnnotationToken(tok: string) {
  if (isChordToken(tok)) return true;
  const clean = tok.replace(/^\(+/, '').replace(/[),.;]+$/, '');
  if (!clean) return true;
  if (/^(\d+x?|x\d+)$/i.test(clean)) return true;
  if (/^(OR|Lick|Riff|to|the)$/i.test(clean)) return true;
  return false;
}

function isChordLine(trimmed: string) {
  const tokens = trimmed.split(/\s+/);
  const hasChord = tokens.some(isChordToken);
  return hasChord && tokens.every(isAnnotationToken);
}

function classifyLine(line: string): { type: 'section' | 'chord' | 'tab' | 'lyric' | 'blank'; text: string } {
  const trimmed = line.trim();
  if (!trimmed) return { type: 'blank', text: line };
  if (/^[eEADGB]?\|[-0-9x|/\\~^()hpb ]*\|?$/.test(trimmed)) return { type: 'tab', text: line };
  if (trimmed.length <= 40 && SECTION_RE.test(trimmed)) return { type: 'section', text: line };
  if (isChordLine(trimmed)) return { type: 'chord', text: line };
  return { type: 'lyric', text: line };
}

function renderLyrics(raw: string) {
  const escape = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  const lines = raw.split('\n').map(classifyLine);

  // A blank line right after a tab line (separating two tab blocks, or
  // ending one) becomes a small dedicated gap instead of a full paragraph
  // break — otherwise it inherits the lyrics block's larger line-height and
  // looks like a much bigger gap than the tightly-packed tab rows around it.
  type RenderType = 'section' | 'chord' | 'tab' | 'tab-gap' | 'lyric' | 'blank';
  const types: RenderType[] = lines.map((l, i) =>
    l.type === 'blank' && lines[i - 1]?.type === 'tab' ? 'tab-gap' : l.type
  );

  // Stanza breaks (any other blank line) get the same treatment, so the gap
  // between verses can be tuned shorter than a full line and fit more of the
  // song on screen.
  //
  // Chord lines are blocks too, so they can have a tighter line-height than
  // lyrics (an inline line can't go below the parent's line-height).
  //
  // Tab lines, chord lines and gaps are block elements that already force their own
  // line break — leaving the raw '\n' in would add an extra blank-line gap
  // (it sits outside the span, so it renders at the parent's line-height).
  return lines
    .map(({ text }, i) => {
      const type = types[i];
      const escaped = escape(text);
      let rendered: string;
      switch (type) {
        case 'section':
          rendered = `<strong class="section-label">${escaped}</strong>`;
          break;
        case 'chord':
          rendered = `<span class="chord-line">${escaped}</span>`;
          break;
        case 'tab':
          rendered = `<span class="tab-line">${escaped}</span>`;
          break;
        case 'tab-gap':
          rendered = `<span class="tab-gap"></span>`;
          break;
        case 'blank':
          rendered = `<span class="stanza-gap"></span>`;
          break;
        default:
          rendered = escaped;
      }
      const prevType = i > 0 ? types[i - 1] : null;
      const separator = i === 0 || prevType === 'tab' || prevType === 'tab-gap' || prevType === 'blank' || prevType === 'chord'
          ? ''
          : '\n';
      return separator + rendered;
    })
    .join('');
}

const lyricsHtml = renderLyrics(text);
---

<Layout title={`${song.title} — ${song.artist} — Off The Map`} description={`Letra de ${song.title}, de ${song.artist}.`}>
  <main class="wrap">
    <a class="back-link" href={`${base}/songbook/`}>&larr; Songbook</a>

    <header class="song-header">
      <h1>{song.title}</h1>
      <p class="artist">{song.artist}</p>
      <p class="meta">{song.bpm}&nbsp;BPM · {keyName(song.key)}</p>
    </header>

    <pre class="lyrics" set:html={lyricsHtml} />
    <script is:inline>
      // Apply the saved size before first paint so the lyrics don't visibly jump.
      try {
        const saved = Number(localStorage.getItem('lyrics-scale'));
        if (saved) document.documentElement.style.setProperty('--lyrics-scale', String(saved));
      } catch {}
    </script>
  </main>

  <div class="play-toolbar hard-sm" role="toolbar" aria-label="Controles de leitura">
    <button type="button" class="tool-btn" data-action="smaller" aria-label="Diminuir fonte">A−</button>
    <span class="scale-label" aria-live="polite">100%</span>
    <button type="button" class="tool-btn" data-action="bigger" aria-label="Aumentar fonte">A+</button>
    <button type="button" class="tool-btn wake-btn" data-action="wake" aria-pressed="false" hidden>
      Tela ligada
    </button>
  </div>
</Layout>

<script>
  const SCALES = [0.6, 0.7, 0.8, 0.9, 1, 1.15, 1.3, 1.5, 1.75, 2, 2.3, 2.6, 3];
  const SCALE_KEY = 'lyrics-scale';
  const WAKE_KEY = 'lyrics-wake';

  const root = document.documentElement;
  const toolbar = document.querySelector<HTMLElement>('.play-toolbar')!;
  const label = toolbar.querySelector<HTMLElement>('.scale-label')!;
  const smallerBtn = toolbar.querySelector<HTMLButtonElement>('[data-action="smaller"]')!;
  const biggerBtn = toolbar.querySelector<HTMLButtonElement>('[data-action="bigger"]')!;
  const wakeBtn = toolbar.querySelector<HTMLButtonElement>('[data-action="wake"]')!;

  // localStorage can throw (private mode, blocked storage) — preferences are a nicety.
  function load(key: string) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function save(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
    } catch {}
  }

  // Font size

  let scaleIndex = SCALES.indexOf(Number(load(SCALE_KEY)));
  if (scaleIndex === -1) scaleIndex = SCALES.indexOf(1);

  function applyScale() {
    const scale = SCALES[scaleIndex];
    root.style.setProperty('--lyrics-scale', String(scale));
    label.textContent = `${Math.round(scale * 100)}%`;
    smallerBtn.disabled = scaleIndex === 0;
    biggerBtn.disabled = scaleIndex === SCALES.length - 1;
    save(SCALE_KEY, String(scale));
  }

  smallerBtn.addEventListener('click', () => {
    scaleIndex = Math.max(0, scaleIndex - 1);
    applyScale();
  });

  biggerBtn.addEventListener('click', () => {
    scaleIndex = Math.min(SCALES.length - 1, scaleIndex + 1);
    applyScale();
  });

  applyScale();

  // Keep the screen awake

  if ('wakeLock' in navigator) {
    let sentinel: WakeLockSentinel | null = null;
    let wanted = load(WAKE_KEY) === '1';

    function render() {
      wakeBtn.setAttribute('aria-pressed', String(sentinel !== null));
    }

    async function acquire() {
      try {
        sentinel = await navigator.wakeLock.request('screen');
        // The browser drops the lock when the tab is hidden; track that so the
        // button reflects reality and we can re-acquire on return.
        sentinel.addEventListener('release', () => {
          sentinel = null;
          render();
        });
      } catch {
        sentinel = null;
      }
      render();
    }

    wakeBtn.addEventListener('click', async () => {
      wanted = !wanted;
      save(WAKE_KEY, wanted ? '1' : '0');
      if (wanted) {
        await acquire();
      } else {
        await sentinel?.release();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (wanted && document.visibilityState === 'visible' && !sentinel) acquire();
    });

    wakeBtn.hidden = false;
    if (wanted) acquire();
  }
</script>

<style>
  main.wrap {
    /* Extra bottom room so the last lines can scroll clear of the toolbar. */
    padding: 1.5rem 1.5rem 7rem;
    /* Wide enough that big font sizes on a tablet don't wrap lines needlessly. */
    max-width: 980px;
  }

  .back-link {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .song-header {
    margin-bottom: 1.2rem;
    padding-bottom: 0.9rem;
    border-bottom: var(--border-w) solid var(--ink);
  }

  h1 {
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    margin-bottom: 0.4rem;
  }

  .artist {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.9rem;
    opacity: 0.65;
  }

  .meta {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.82rem;
    opacity: 0.5;
    margin-top: 0.4rem;
    font-variant-numeric: tabular-nums;
  }

  .lyrics {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    white-space: pre-wrap;
    word-wrap: break-word;
    /* Child sizes below are in em so they scale along with --lyrics-scale. */
    /* Sizes that drive the vertical rhythm are rounded to whole pixels: with
       fractional sizes each row lands on a different sub-pixel offset and the
       glyphs snap unevenly, so identical chord/lyric gaps render 1-2px apart. */
    --fs: round(calc(1.05rem * var(--lyrics-scale, 1)), 1px);
    font-size: var(--fs);
    line-height: round(calc(var(--fs) * 1.4), 1px);
    margin: 0;
  }

  .lyrics :global(.section-label) {
    display: inline-block;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.81em;
    opacity: 0.6;
  }

  .lyrics :global(.chord-line) {
    display: block;
    line-height: var(--fs);
    /* Chords are mostly capitals with no descenders, so the bottom of their
       box is empty — tuck the chord down onto the lyric it belongs to. */
    margin-top: round(calc(var(--fs) * 0.15), 1px);
    margin-bottom: round(calc(var(--fs) * -0.3), 1px);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-weight: 700;
    color: var(--pink);
  }

  .lyrics :global(.tab-line) {
    display: block;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.81em;
    line-height: 1.4;
    color: var(--ink);
    background: color-mix(in srgb, var(--periwinkle) 12%, transparent);
    border-left: 3px solid var(--periwinkle);
    padding: 0 0.5rem;
    margin-left: -0.5rem;
    width: fit-content;
    /* Wrapping a tab row scrambles it — at big sizes, scroll sideways instead. */
    white-space: pre;
    max-width: calc(100% + 0.5rem);
    overflow-x: auto;
  }

  .lyrics :global(.stanza-gap) {
    display: block;
    height: round(calc(var(--fs) * 0.9), 1px);
  }

  .lyrics :global(.tab-gap) {
    display: block;
    height: 0.6em;
  }

  .play-toolbar {
    position: fixed;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem;
    background: var(--paper);
    font-family: 'Space Grotesk', sans-serif;
  }

  .tool-btn {
    font: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    touch-action: manipulation;
  }

  .tool-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .wake-btn {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-left: 0.35rem;
  }

  .wake-btn[aria-pressed='true'] {
    background: var(--lime);
  }

  .scale-label {
    min-width: 3.2rem;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
</style>
