---
import Layout from '../../layouts/Layout.astro';
import { uniqueSongs, songSlug, keyName } from '../../data/songs';
import { lyrics } from '../../data/lyrics';

export function getStaticPaths() {
  return uniqueSongs()
    .filter((song) => lyrics[songSlug(song)])
    .map((song) => ({
      params: { slug: songSlug(song) },
      props: { song },
    }));
}

const { song } = Astro.props;
const text = lyrics[songSlug(song)];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function renderLyrics(raw: string) {
  const escape = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  return raw
    .split('\n')
    .map((line) => (line.trim() === 'Chorus' ? '<strong class="section-label">Chorus</strong>' : escape(line)))
    .join('\n');
}

const lyricsHtml = renderLyrics(text);
---

<Layout title={`${song.title} — ${song.artist} — Off The Map`} description={`Letra de ${song.title}, de ${song.artist}.`}>
  <main class="wrap">
    <a class="back-link" href={`${base}/songbook/`}>&larr; Songbook</a>

    <header class="song-header">
      <h1>{song.title}</h1>
      <p class="artist">{song.artist}</p>
      <p class="meta">{song.bpm}&nbsp;BPM · {keyName(song.key)}</p>
    </header>

    <pre class="lyrics" set:html={lyricsHtml} />
  </main>
</Layout>

<style>
  main.wrap {
    padding: 2.5rem 1.5rem 4rem;
    max-width: 700px;
  }

  .back-link {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .song-header {
    margin-bottom: 2rem;
    padding-bottom: 1.2rem;
    border-bottom: var(--border-w) solid var(--ink);
  }

  h1 {
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    margin-bottom: 0.4rem;
  }

  .artist {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.9rem;
    opacity: 0.65;
  }

  .meta {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.82rem;
    opacity: 0.5;
    margin-top: 0.4rem;
    font-variant-numeric: tabular-nums;
  }

  .lyrics {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    white-space: pre-wrap;
    word-wrap: break-word;
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  .lyrics :global(.section-label) {
    display: inline-block;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    opacity: 0.6;
  }
</style>
