---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { uniqueSongs, songSlug } from '../../data/songs';
import { lyrics } from '../../data/lyrics';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const songs = uniqueSongs();
---

<Layout title="Off The Map — Songbook" description="Todas as letras do repertório da banda, uma por uma.">
  <Nav />

  <header class="hero">
    <div class="wrap">
      <p class="badge hard-sm" style="background: var(--lime);">Songbook</p>
      <h1>Letras</h1>
      <p class="subtitle">Todo o repertório, uma música por vez. Clique pra ver a letra.</p>
    </div>
  </header>

  <main class="wrap">
    <div class="search-box">
      <input
        type="search"
        id="song-search"
        class="search-input"
        placeholder="Buscar por música ou banda..."
        autocomplete="off"
      />
    </div>

    <p class="no-results" id="no-results" hidden>Nenhuma música encontrada.</p>

    <ul class="song-list hard" id="song-list">
      {songs.map((song) => {
        const slug = songSlug(song);
        const hasLyrics = Boolean(lyrics[slug]);
        return (
          <li class="song-item" data-title={song.title.toLowerCase()} data-artist={song.artist.toLowerCase()}>
            {hasLyrics ? (
              <a class="song-link" href={`${base}/songbook/${slug}/`}>
                <span class="title">{song.title}</span>
                <span class="artist">{song.artist}</span>
              </a>
            ) : (
              <span class="song-link is-disabled" aria-disabled="true">
                <span class="title">{song.title}</span>
                <span class="artist">{song.artist}</span>
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </main>

  <Footer />
</Layout>

<script>
  const input = document.getElementById('song-search') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#song-list .song-item'));
  const noResults = document.getElementById('no-results');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visibleCount = 0;

    items.forEach((item) => {
      const matches =
        !query ||
        (item.dataset.title ?? '').includes(query) ||
        (item.dataset.artist ?? '').includes(query);
      item.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    if (noResults) noResults.hidden = visibleCount > 0;
  });
</script>

<style>
  .hero {
    padding: 2.5rem 0 1.5rem;
    background: var(--ink);
    color: var(--paper);
    border-bottom: var(--border-w) solid var(--pink);
  }

  .badge {
    color: var(--ink);
    margin-bottom: 0.9rem;
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 3.2rem);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 0.95rem;
    opacity: 0.8;
    max-width: 32rem;
  }

  main.wrap {
    padding: 2rem 1.5rem 3rem;
  }

  .search-box {
    margin-bottom: 1.2rem;
  }

  .search-input {
    width: 100%;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    padding: 0.75rem 0.9rem;
    background: var(--paper);
    color: var(--ink);
    border: var(--border-w) solid var(--ink);
    border-radius: 8px;
  }

  .search-input::placeholder {
    color: color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--pink);
  }

  .no-results {
    padding: 0.9rem;
    font-size: 0.9rem;
    opacity: 0.65;
  }

  .song-list {
    list-style: none;
    margin: 0;
    padding: 0.3rem;
    background: var(--paper);
  }

  /* General sibling (~), not adjacent (+): a visible item only gets the
     separator if SOME earlier item is also visible, no matter how many
     hidden (filtered-out) items sit between them. This keeps it at exactly
     one separator per gap between visible results while searching. */
  .song-item:not([hidden]) ~ .song-item:not([hidden]) {
    border-top: 2px dashed color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .song-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.9rem;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.12s ease;
  }

  a.song-link:hover {
    background: var(--sky);
  }

  .song-link.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .title {
    font-weight: 700;
    font-size: 1rem;
  }

  .artist {
    font-size: 0.82rem;
    opacity: 0.65;
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .song-link {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
