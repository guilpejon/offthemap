---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { uniqueSongs, songSlug, toSeconds, keySortValue } from '../../data/songs';
import { lyrics } from '../../data/lyrics';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const songs = uniqueSongs();
---

<Layout title="Off The Map — Songbook" description="Todas as letras do repertório da banda, uma por uma.">
  <Nav />

  <header class="hero">
    <div class="wrap">
      <p class="badge hard-sm" style="background: var(--lime);">Songbook</p>
      <h1>Letras</h1>
      <p class="subtitle">Todo o repertório, uma música por vez. Clique pra ver a letra.</p>
    </div>
  </header>

  <main class="wrap">
    <div class="search-box">
      <input
        type="search"
        id="song-search"
        class="search-input"
        placeholder="Buscar por música ou banda..."
        autocomplete="off"
      />
    </div>

    <p class="no-results" id="no-results" hidden>Nenhuma música encontrada.</p>

    <div class="sort-bar" role="group" aria-label="Ordenar músicas">
      <button type="button" class="badge hard-sm sort-btn active-asc" data-sort="alpha">A-Z</button>
      <button type="button" class="badge hard-sm sort-btn" data-sort="length">Duração</button>
      <button type="button" class="badge hard-sm sort-btn" data-sort="bpm">BPM</button>
      <button type="button" class="badge hard-sm sort-btn" data-sort="key">Tom</button>
    </div>

    <ul class="song-list hard" id="song-list">
      {songs.map((song) => {
        const slug = songSlug(song);
        const hasLyrics = Boolean(lyrics[slug]);
        return (
          <li
            class="song-item"
            data-title={song.title.toLowerCase()}
            data-artist={song.artist.toLowerCase()}
            data-length-seconds={toSeconds(song.length)}
            data-bpm={song.bpm}
            data-key-sort={keySortValue(song.key)}
          >
            {hasLyrics ? (
              <a class="song-link" href={`${base}/songbook/${slug}/`}>
                <span class="title">{song.title}</span>
                <span class="artist">{song.artist}</span>
              </a>
            ) : (
              <span class="song-link is-disabled" aria-disabled="true">
                <span class="title">{song.title}</span>
                <span class="artist">{song.artist}</span>
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </main>

  <Footer />
</Layout>

<script>
  const input = document.getElementById('song-search') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#song-list .song-item'));
  const noResults = document.getElementById('no-results');

  // Strip diacritics so "zoio" matches "zóio" and vice versa.
  const normalize = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '');

  input?.addEventListener('input', () => {
    const query = normalize(input.value.trim().toLowerCase());
    let visibleCount = 0;

    items.forEach((item) => {
      const matches =
        !query ||
        normalize(item.dataset.title ?? '').includes(query) ||
        normalize(item.dataset.artist ?? '').includes(query);
      item.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    if (noResults) noResults.hidden = visibleCount > 0;
  });

  type SortKey = 'alpha' | 'length' | 'bpm' | 'key';
  type SortState = { key: SortKey; dir: 'asc' | 'desc' };

  const DEFAULT_SORT: SortState = { key: 'alpha', dir: 'asc' };

  function getValue(row: HTMLElement, key: SortKey): string | number {
    switch (key) {
      case 'alpha':
        return row.dataset.title ?? '';
      case 'length':
        return Number(row.dataset.lengthSeconds);
      case 'bpm':
        return Number(row.dataset.bpm);
      case 'key':
        return Number(row.dataset.keySort);
    }
  }

  const list = document.getElementById('song-list');
  const sortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.sort-btn'));
  let activeSort: SortState = DEFAULT_SORT;

  function applySort() {
    if (!list) return;
    const rows = Array.from(list.children) as HTMLElement[];
    const { key, dir } = activeSort;
    rows.sort((a, b) => {
      const va = getValue(a, key);
      const vb = getValue(b, key);
      const cmp = typeof va === 'string' ? va.localeCompare(vb as string, 'pt-BR') : va - (vb as number);
      return dir === 'asc' ? cmp : -cmp;
    });
    rows.forEach((row) => list.appendChild(row));
  }

  function updateButtonStates() {
    sortButtons.forEach((btn) => {
      btn.classList.remove('active-asc', 'active-desc');
      if (btn.dataset.sort === activeSort.key) {
        btn.classList.add(activeSort.dir === 'asc' ? 'active-asc' : 'active-desc');
      }
    });
  }

  sortButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort as SortKey;
      if (activeSort.key === key) {
        activeSort = activeSort.dir === 'asc' ? { key, dir: 'desc' } : DEFAULT_SORT;
      } else {
        activeSort = { key, dir: 'asc' };
      }
      applySort();
      updateButtonStates();
    });
  });
</script>

<style>
  .hero {
    padding: 2.5rem 0 1.5rem;
    background: var(--ink);
    color: var(--paper);
    border-bottom: var(--border-w) solid var(--pink);
  }

  .badge {
    color: var(--ink);
    margin-bottom: 0.9rem;
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 3.2rem);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 0.95rem;
    opacity: 0.8;
    max-width: 32rem;
  }

  main.wrap {
    padding: 2rem 1.5rem 3rem;
  }

  .search-box {
    margin-bottom: 1.2rem;
  }

  .sort-bar {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }

  .sort-btn {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--ink);
    cursor: pointer;
    font: inherit;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease, color 0.12s ease;
  }

  .sort-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--ink);
  }

  .sort-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 0 var(--ink);
  }

  .sort-btn.active-asc {
    background: var(--pink);
    color: var(--ink);
  }

  .sort-btn.active-desc {
    background: var(--ink);
    color: var(--paper);
  }

  .search-input {
    width: 100%;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    padding: 0.75rem 0.9rem;
    background: var(--paper);
    color: var(--ink);
    border: var(--border-w) solid var(--ink);
    border-radius: 8px;
  }

  .search-input::placeholder {
    color: color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--pink);
  }

  .no-results {
    padding: 0.9rem;
    font-size: 0.9rem;
    opacity: 0.65;
  }

  .song-list {
    list-style: none;
    margin: 0;
    padding: 0.3rem;
    background: var(--paper);
  }

  /* General sibling (~), not adjacent (+): a visible item only gets the
     separator if SOME earlier item is also visible, no matter how many
     hidden (filtered-out) items sit between them. This keeps it at exactly
     one separator per gap between visible results while searching. */
  .song-item:not([hidden]) ~ .song-item:not([hidden]) {
    border-top: 2px dashed color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .song-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.9rem;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.12s ease;
  }

  a.song-link:hover {
    background: var(--sky);
  }

  .song-link.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .title {
    font-weight: 700;
    font-size: 1rem;
  }

  .artist {
    font-size: 0.82rem;
    opacity: 0.65;
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .song-link {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
