---
import { artistCounts, totalRuntimeLabel, allSongs } from '../data/songs';
import ArtistChart from './ArtistChart.astro';

const counts = artistCounts();
const top = counts[0];
const totalBands = counts.length;
const total = allSongs().length;
---

<section id="numeros" class="stats">
  <div class="dots dot-grid" aria-hidden="true"></div>
  <div class="wrap stats-inner">
    <span class="badge hard-sm tag">Números do repertório</span>
    <h2>Quem a gente mais toca</h2>
    <p class="subtitle">Um raio-x de tudo que ensaiamos, banda por banda.</p>

    <div class="tiles">
      <div class="tile hard">
        <strong>{totalBands}</strong>
        <span>bandas diferentes</span>
      </div>
      <div class="tile hard">
        <strong>{totalRuntimeLabel()}</strong>
        <span>de repertório todo</span>
      </div>
      <div class="tile hard">
        <strong>{total}</strong>
        <span>músicas no total</span>
      </div>
    </div>

    <div class="chart-card hard">
      <span class="sticker hard-sm">👑 {top.artist}</span>
      <h3>Músicas por banda</h3>
      <ArtistChart />
    </div>
  </div>
</section>

<style>
  .stats {
    position: relative;
    background: color-mix(in srgb, var(--sky) 35%, var(--paper));
    color: var(--ink);
    padding: 4rem 0;
    overflow: hidden;
    scroll-margin-top: 4.5rem;
  }

  .dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--ink);
  }

  .stats-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .subtitle {
    max-width: 40rem;
    opacity: 0.75;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    width: 100%;
  }

  .tile {
    background: var(--paper);
    padding: 1rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 9.5rem;
  }

  .tile strong {
    font-family: 'Archivo Black', sans-serif;
    font-size: 1.6rem;
    line-height: 1;
  }

  .tile span {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.65;
    font-weight: 700;
  }

  .chart-card {
    position: relative;
    background: var(--paper);
    padding: 2rem 1.5rem 1.5rem;
    width: 100%;
    margin-top: 1.5rem;
    box-shadow: var(--shadow-x) var(--shadow-y) 0 0 var(--pink);
  }

  .chart-card h3 {
    font-size: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .sticker {
    position: absolute;
    top: -1.1rem;
    right: 1.2rem;
    background: var(--lime);
    color: var(--ink);
    transform: rotate(-4deg);
    font-size: 0.72rem;
    max-width: 65%;
    text-align: center;
  }

  @media (max-width: 640px) {
    .stats {
      padding: 3rem 0;
      scroll-margin-top: 9rem;
    }

    .sticker {
      position: static;
      transform: none;
      margin-bottom: 1rem;
      display: inline-flex;
    }
  }
</style>
