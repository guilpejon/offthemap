---
import type { Section } from '../data/songs';
import { totalLength } from '../data/songs';
import SongRow from './SongRow.astro';

interface Props {
  section: Section;
  dark: boolean;
}

const { section, dark } = Astro.props;

const accentVar: Record<Section['accent'], string> = {
  pink: 'var(--pink)',
  periwinkle: 'var(--periwinkle)',
  lime: 'var(--lime)',
  sky: 'var(--sky)',
};
const accent = accentVar[section.accent];

// Default view is alphabetical; the row number reflects that default rank.
const alphabeticalSongs = [...section.songs]
  .sort((a, b) => a.title.localeCompare(b.title, 'pt-BR'))
  .map((song, i) => ({ song, index: i + 1 }));
---

<section id={section.id} class:list={['sect', { dark }]} style={`--accent: ${accent};`}>
  {dark && <div class="dots dot-grid" aria-hidden="true"></div>}
  <div class="wrap">
    <div class="sect-head">
      <span class="badge hard-sm tag">{section.title}</span>
      <h2>{section.title}</h2>
      <p class="subtitle">{section.subtitle}</p>
      <p class="stats-text">{section.songs.length}&nbsp;músicas · {totalLength(section.songs)}</p>
      <div class="sort-bar" role="group" aria-label="Ordenar músicas">
        <button type="button" class="badge hard-sm sort-btn active-asc" data-sort="alpha">A-Z</button>
        <button type="button" class="badge hard-sm sort-btn" data-sort="length">Duração</button>
        <button type="button" class="badge hard-sm sort-btn" data-sort="bpm">BPM</button>
        <button type="button" class="badge hard-sm sort-btn" data-sort="key">Tom</button>
      </div>
    </div>

    <ol class="song-list hard">
      {alphabeticalSongs.map(({ song, index }) => (
        <SongRow index={index} song={song} accent={accent} />
      ))}
    </ol>
  </div>
</section>

<script>
  type SortKey = 'alpha' | 'length' | 'bpm' | 'key';
  type SortState = { key: SortKey; dir: 'asc' | 'desc' };

  const DEFAULT_SORT: SortState = { key: 'alpha', dir: 'asc' };

  function getValue(row: HTMLElement, key: SortKey): string | number {
    switch (key) {
      case 'alpha':
        return row.dataset.title ?? '';
      case 'length':
        return Number(row.dataset.lengthSeconds);
      case 'bpm':
        return Number(row.dataset.bpm);
      case 'key':
        return Number(row.dataset.keySort);
    }
  }

  document.querySelectorAll<HTMLElement>('.sect').forEach((section) => {
    const list = section.querySelector<HTMLOListElement>('.song-list');
    const buttons = section.querySelectorAll<HTMLButtonElement>('.sort-btn');
    if (!list || buttons.length === 0) return;

    let activeSort: SortState = DEFAULT_SORT;

    function applySort() {
      const items = Array.from(list!.children) as HTMLElement[];
      const { key, dir } = activeSort;
      items.sort((a, b) => {
        const va = getValue(a, key);
        const vb = getValue(b, key);
        const cmp = typeof va === 'string' ? va.localeCompare(vb as string, 'pt-BR') : va - (vb as number);
        return dir === 'asc' ? cmp : -cmp;
      });
      items.forEach((item) => list!.appendChild(item));
    }

    function updateButtonStates() {
      buttons.forEach((btn) => {
        btn.classList.remove('active-asc', 'active-desc');
        if (btn.dataset.sort === activeSort.key) {
          btn.classList.add(activeSort.dir === 'asc' ? 'active-asc' : 'active-desc');
        }
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort as SortKey;
        if (activeSort.key === key) {
          activeSort = activeSort.dir === 'asc' ? { key, dir: 'desc' } : DEFAULT_SORT;
        } else {
          activeSort = { key, dir: 'asc' };
        }
        applySort();
        updateButtonStates();
      });
    });
  });
</script>

<style>
  .sect {
    position: relative;
    padding: 4rem 0;
    background: var(--paper);
    color: var(--ink);
    scroll-margin-top: 4.5rem;
  }

  .sect.dark {
    background: var(--ink);
    color: var(--paper);
  }

  .dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sect-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-bottom: 2.2rem;
    position: relative;
  }

  .tag {
    background: var(--accent);
    color: var(--ink);
    border-color: currentColor;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .tag:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--ink);
  }

  .tag:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 0 var(--ink);
  }

  .sect.dark .tag {
    border-color: var(--paper);
    box-shadow: 4px 4px 0 0 var(--paper);
  }

  .sect.dark .tag:hover {
    box-shadow: 6px 6px 0 0 var(--paper);
  }

  .sect.dark .tag:active {
    box-shadow: 1px 1px 0 0 var(--paper);
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .subtitle {
    max-width: 40rem;
    opacity: 0.75;
    font-size: 1rem;
  }

  .stats-text {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .sort-bar {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .sort-btn {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--ink);
    cursor: pointer;
    font: inherit;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease, color 0.12s ease;
  }

  .sort-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--ink);
  }

  .sort-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 0 var(--ink);
  }

  .sort-btn.active-asc {
    background: var(--accent);
    color: var(--ink);
  }

  .sort-btn.active-desc {
    background: var(--ink);
    color: var(--paper);
  }

  .sect.dark .sort-btn {
    background: transparent;
    border-color: var(--paper);
    color: var(--paper);
    box-shadow: 4px 4px 0 0 var(--paper);
  }

  .sect.dark .sort-btn:hover {
    box-shadow: 6px 6px 0 0 var(--paper);
  }

  .sect.dark .sort-btn:active {
    box-shadow: 1px 1px 0 0 var(--paper);
  }

  .sect.dark .sort-btn.active-asc {
    background: var(--accent);
    color: var(--ink);
    border-color: var(--ink);
  }

  .sect.dark .sort-btn.active-desc {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--ink);
  }

  .song-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.2rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-x) var(--shadow-y) 0 0 var(--accent);
    position: relative;
  }

  .sect.dark .song-list {
    border-color: var(--paper);
  }

  @media (max-width: 640px) {
    .sect {
      padding: 3rem 0;
      scroll-margin-top: 9rem;
    }

    .song-list {
      padding: 0.4rem 0.8rem;
    }
  }
</style>
